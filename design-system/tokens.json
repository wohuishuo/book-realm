{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "Book Realm",
    "version": "1.0.0",
    "reference": "WeRead-first, Qidian-fallback"
  },
  "color": {
    "light": {
      "background": "#F7F8FA",
      "surface": "#FFFFFF",
      "surfaceMuted": "#F1F3F5",
      "textPrimary": "#20242A",
      "textSecondary": "#727982",
      "textDisabled": "#AEB4BC",
      "border": "#E6E9ED",
      "brand": "#2F7CF6",
      "onBrand": "#FFFFFF",
      "danger": "#D84A4A",
      "readerPaper": "#F6F3EC",
      "readerNight": "#17191C"
    },
    "dark": {
      "background": "#101214",
      "surface": "#191C20",
      "surfaceMuted": "#23272C",
      "textPrimary": "#F1F3F5",
      "textSecondary": "#A8AFB8",
      "textDisabled": "#666D76",
      "border": "#30353B",
      "brand": "#5B9BFF",
      "onBrand": "#08111F",
      "danger": "#FF7373",
      "readerPaper": "#D8D0C2",
      "readerNight": "#111315"
    }
  },
  "space": { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "xxl": 32 },
  "radius": { "sm": 4, "md": 8, "lg": 12, "round": 999 },
  "size": {
    "topBar": 56,
    "bottomNav": 64,
    "readerToolbar": 56,
    "touchTarget": 48,
    "icon": 24,
    "button": 48,
    "contentMaxWidth": 720
  },
  "type": {
    "display": { "fontSize": 28, "lineHeight": 36, "fontWeight": 700 },
    "title": { "fontSize": 20, "lineHeight": 28, "fontWeight": 600 },
    "section": { "fontSize": 17, "lineHeight": 24, "fontWeight": 600 },
    "body": { "fontSize": 16, "lineHeight": 24, "fontWeight": 400 },
    "label": { "fontSize": 14, "lineHeight": 20, "fontWeight": 500 },
    "caption": { "fontSize": 12, "lineHeight": 16, "fontWeight": 400 },
    "reader": { "fontSize": 18, "lineHeight": 31, "fontWeight": 400 }
  },
  "motion": { "fast": 120, "standard": 200, "slow": 300 }
}
